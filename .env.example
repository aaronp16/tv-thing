# tv-thing environment configuration
# Copy to .env for dev on the homelab server. In Docker these come from ~/homelab/docker-compose.yml.

# TorrentLeech credentials (required)
TL_USERNAME=your_username
TL_PASSWORD=your_password
# TL_2FA_TOKEN=

# qBittorrent WebUI (published on the host at 8080)
QB_URL=http://localhost:8080
QB_USERNAME=admin
QB_PASSWORD=your_qbittorrent_password
# QB_SAVE_PATH=

# Real host paths so dev sees the same data as prod (Docker defaults: /media, /torrents)
MEDIA_DIR=/home/aaron/homelab/data/media
TORRENT_DOWNLOAD_DIR=/home/aaron/homelab/data/torrents

# Persistent app data (watch list). Docker default: /config
DATA_DIR=/home/aaron/homelab/config/tv-thing

# TMDB
TMDB_API_KEY=your_tmdb_key
TMDB_REGION=GB

# Jellyfin
JELLYFIN_URL=http://192.168.1.69:8096
JELLYFIN_API_KEY=your_jellyfin_api_key
